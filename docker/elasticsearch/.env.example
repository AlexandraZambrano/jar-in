# Copy to `.env` (git-ignored) and change the three secrets.
# `docker compose` reads `.env` from this folder automatically.

# Superuser. Used by you in Kibana and to create the API key Jars asks for.
ELASTIC_PASSWORD=change-me

# Internal account Kibana uses to talk to Elasticsearch.
KIBANA_PASSWORD=change-me-too

# 32+ characters, any string. Keeps Kibana's saved objects valid across restarts.
KIBANA_ENCRYPTION_KEY=change-me-to-a-random-string-of-32-or-more-chars

# Host ports (all bound to 127.0.0.1 only). Change one if it is taken — e.g.
# another Elasticsearch already owns 9200, or `npm run dev` owns 5173. If you
# change APP_PORT, CORS follows it automatically.
ES_PORT=9200
KIBANA_PORT=5601
APP_PORT=5173
